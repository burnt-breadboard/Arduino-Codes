// --- PROTOTYPES ---
void typebox(const __FlashStringHelper* text, int speed);
void typebox(String text, int speed);
void drawStaticUI();
void startBattle();
void executeMove();
void showOutro();
void drawMenu();
void handleMenuInput();
void softShake(int intensity, int duration);
void playerShake(int intensity, int duration);
void drainEnemyHP(int damage);
void drainPlayerHP(int damage);
void healPlayer(int amount);

// --- SETUP ---
void setup() {
  // Wire.begin(PIN_SDA, PIN_SCL);   <----for I2C screen
  // Wire.setClock(400000);
   if(!display.begin(SSD1306_SWITCHCAPVCC)) for(;;); 
  
  pinMode(BTN_A, INPUT_PULLUP);
  pinMode(BTN_UP, INPUT_PULLUP);
  pinMode(BTN_DOWN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  randomSeed(analogRead(0));

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE); 

  // --- INTRO SCREEN DRAWING ---
  display.setFont(); 
  display.setTextSize(2);
  display.setCursor(28, 10);
  display.print(F("ROBERT"));

  display.setTextSize(1);
  display.setCursor(15, 30);
  display.print(F("grew to level 37!"));
  display.display();

  // --- Global Font Change ---
  display.setFont(&Picopixel); 
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE); // Set it again here just to be safe
  display.setCursor(10, 55);
  display.print(F("Press  A  for  a  birthday  battle!"));

  display.display();
}

// --- MAIN LOOP ---
void loop() {
  switch (gamePhase) {
    case 0: // Phase 0: INTRO
      if (digitalRead(BTN_A) == LOW) {
        while(digitalRead(BTN_A) == LOW); delay(250);
        gamePhase = 1;
      }
      break;

    case 1: // Phase 1: SELECTION
      drawSelectionMenu(); 
      break;

    case 2: // Phase 2: BATTLE
      if (gamePhase == 2) { 
        handleMenuInput();
        drawMenu();
      }
      break;

    case 3: // Phase 3: OUTRO
   showOutro();
   if (digitalRead(BTN_A) == LOW) {
    while(digitalRead(BTN_A) == LOW);
    delay(200);
    enemyHP = 100;
    playerHP = 100;
    melodyPlayed = false; // <--- RESETS THE FLAG 
    gamePhase = 0;
    display.clearDisplay();
    display.display();
    setup();  // Girl, IDK. It keeps the font from resetting
  }
  break;

    case 4: // Phase 4: DEFEAT
      display.clearDisplay(); 
      display.setTextSize(2);
      display.setCursor(40, 20);
      display.print(F("ROBERT"));
      display.setCursor(25, 35);
      display.print(F("BLACKED OUT!"));
      
      display.setTextSize(1);
      display.setCursor(18, 50);
      display.print(F("DOUBLE-CLICK  A  TO RESTART"));
      display.display();

      //You know what, just double click then. It's a feature not a bug, bitch. 
      if (digitalRead(BTN_A) == HIGH) {
        readyToRestart = true; 
      }

      if (readyToRestart == true && digitalRead(BTN_A) == LOW) {
        delay(100); // Debounce
        while(digitalRead(BTN_A) == LOW); // Wait for final release
        
        // RESET EVERYTHING
        playerHP = 100;
        enemyHP = 100;
        readyToRestart = false; 
        gamePhase = 0;  
      }
      break;
   }
  }

// --- FUNCTIONS ---
void drawSelectionMenu() {
  display.clearDisplay();
  display.setCursor(5, 10);
  display.print(F("SELECT YOUR POKEMON:"));
  for(int i = 0; i < 4; i++) {
    display.setCursor(10, 25 + (i * 10));
    display.print(playerChoice == i ? F(">") : F(" "));
    display.print(playerNames[i]);
  }
  display.drawBitmap(80, 15, playerFrontSprites[playerChoice], 42, 42, WHITE);
  display.display();

  if (digitalRead(BTN_UP) == LOW) {
    playerChoice = (playerChoice - 1 + 4) % 4;
    tone(BUZZER_PIN, 400, 50);
    while(digitalRead(BTN_UP) == LOW); delay(200);
  }
  if (digitalRead(BTN_DOWN) == LOW) {
    playerChoice = (playerChoice + 1) % 4;
    tone(BUZZER_PIN, 400, 50);
    while(digitalRead(BTN_DOWN) == LOW); delay(200);
  }
  if (digitalRead(BTN_A) == LOW) {
    while(digitalRead(BTN_A) == LOW); delay(250);
    randomSeed(millis());
    currentEnemy = random(0, 3);
    gamePhase = 2;
    startBattle();
  }
}

void executeMove() {
  String currentMove = moveNames[playerChoice][menuOption];
  typebox(String(playerNames[playerChoice]) + " used", 40);
  typebox(currentMove + "!", 40);

  // --- ALAKAZAM RECOVER LOGIC ---
  if (playerChoice == 2 && menuOption == 1) { 
    int healAmount = 35; // Amount to heal
    typebox(F("HP was restored!"), 50);
    healPlayer(healAmount);
  } 
  // --- STANDARD ATTACK LOGIC ---
  else {
    if (random(0, 100) < 15) {
      typebox(String(playerNames[playerChoice]) + "'s attack missed", 40);
    } else {
      bool isCrit = (random(0, 100) > 85);
      int damage = random(25, 45) * (isCrit ? 1.5 : 1);
      tone(BUZZER_PIN, 150, 200);
      delay(200);
      softShake(isCrit ? 6 : 3, 10);
      if (isCrit) typebox(F("CRITICAL HIT!"), 30);
      drainEnemyHP(damage);
    }
  }

  // Check for Victory
 if (enemyHP <= 0) { 
    typebox(String("Enemy ") + enemyNames[currentEnemy] + " fainted!", 40);
    delay(1000); 
    gamePhase = 3; 
    return; 
}

   // --- ENEMY TURN ---
  delay(1000);
  // Pick a random move index (0, 1, or 2)
  int randomMove = random(0, 3);
  typebox(String(enemyNames[currentEnemy]) + " used", 40); 
  // Display the randomly chosen move name
  typebox(String(enemyMoves[currentEnemy][randomMove]) + "!", 40); 
  playerShake(3, 10);
  
  int enemyDamage = random(15, 30);
  if (randomMove == 2) enemyDamage += 20; // Make the 3rd move a "Heavy" attack
  
  drainPlayerHP(enemyDamage);

  // 3. NEW: Check for Defeat
  if (playerHP <= 0) { 
    typebox(String(playerNames[playerChoice]) + " fainted!", 40);
    delay(1000);
    typebox(F("Robert is out of usable Pokemon..."), 40);
    
    // Reset everything to "Fresh Start" state
    playerHP = 100;
    enemyHP = 100;
    melodyPlayed = false;

    gamePhase = 4; 
    
    // Clear the screen
    display.clearDisplay();
    display.display();
    
    // 4. IMPORTANT: Exit this function NOW so it doesn't draw the menu again
    return;
  }
}

void drawStaticUI() {
  display.drawRect(0, 44, 128, 20, WHITE);
  display.setCursor(2, 6); display.print(enemyNames[currentEnemy]);
  display.drawRect(2, 9, 34, 5, WHITE);
  display.fillRect(4, 11, map(enemyHP, 0, 100, 0, 30), 1, WHITE);
  display.setCursor(80, 50); display.print(playerNames[playerChoice]);
  display.drawRect(80, 53, 34, 5, WHITE); 
  display.fillRect(82, 55, map(playerHP, 0, 100, 0, 30), 1, WHITE);
}

void startBattle() {
  display.clearDisplay();
  display.drawBitmap(84, 2, enemySprites[currentEnemy], 42, 42, WHITE); 
  display.drawBitmap(2, 12, playerBackSprites[playerChoice], 42, 42, WHITE); 
  drawStaticUI();
  display.display();
  typebox(String(playerNames[playerChoice]) + ", I choose you!", 40);
}

void drawMenu() {
  display.fillRect(1, 45, 126, 18, BLACK);
  display.setCursor(6, 56); display.print(F("MOVE:"));

  display.setCursor(65, 50); 
  display.print(menuOption == 0 ? F(">") : F(" ")); 
  display.print(moveNames[playerChoice][0]);

  display.setCursor(65, 56); 
  display.print(menuOption == 1 ? F(">") : F(" ")); 
  display.print(moveNames[playerChoice][1]);

  display.setCursor(65, 62); 
  display.print(menuOption == 2 ? F(">") : F(" ")); 
  display.print(moveNames[playerChoice][2]);

  display.display();
}

void handleMenuInput() {
  if (digitalRead(BTN_UP) == LOW) {
    menuOption = (menuOption - 1 + 3) % 3;
    tone(BUZZER_PIN, 400, 50);
    while(digitalRead(BTN_UP) == LOW); delay(100);
  }
  if (digitalRead(BTN_DOWN) == LOW) {
    menuOption = (menuOption + 1) % 3;
    tone(BUZZER_PIN, 400, 50);
    while(digitalRead(BTN_DOWN) == LOW); delay(100);
  }
  if (digitalRead(BTN_A) == LOW) {
    while(digitalRead(BTN_A) == LOW); executeMove();
  }
}

void showOutro() {
  display.clearDisplay();
  
  // 1. VICTORY! (System font size 2)
  display.setFont(); 
  display.setTextSize(2);
  display.setCursor(16, 5); 
  display.print(F("VICTORY!"));

  // 2. HAPPY BIRTHDAY (Picopixel font)
  display.setFont(&Picopixel);
  display.setTextSize(2); 
  display.setCursor(9, 40); 
  display.print(F("HAPPY BIRTHDAY!"));

  // 3. PRESS A TO REPLAY (System font size 1)
  display.setFont(); 
  display.setTextSize(1);
  display.setCursor(13, 56);
  display.print(F("PRESS A TO REPLAY"));

  display.display();

   if (!melodyPlayed) {
    playVictoryMelody();
    melodyPlayed = true; 
  }
}


void drainEnemyHP(int damage) {
  int targetHP = enemyHP - damage;
  if (targetHP < 0) targetHP = 0;
  for (int i = enemyHP; i >= targetHP; i--) {
    enemyHP = i;
    display.fillRect(4, 11, 31, 1, BLACK); 
    display.fillRect(4, 11, map(enemyHP, 0, 100, 0, 30), 1, WHITE);
    tone(BUZZER_PIN, map(enemyHP, 100, 0, 800, 200), 20);
    display.display();
    delay(40);
  }
  noTone(BUZZER_PIN);
}

void drainPlayerHP(int damage) {
  int targetHP = playerHP - damage;
  if (targetHP < 0) targetHP = 0;
  for (int i = playerHP; i >= targetHP; i--) {
    playerHP = i;
    display.fillRect(82, 55, 31, 1, BLACK); 
    display.fillRect(82, 55, map(playerHP, 0, 100, 0, 30), 1, WHITE);
    tone(BUZZER_PIN, 1200 - (playerHP * 5), 20); 
    display.display();
    delay(40);
  }
  noTone(BUZZER_PIN);
}

void softShake(int intensity, int duration) {
  for (int i = 0; i < duration; i++) {
    int x = random(-intensity, intensity + 1);
    display.clearDisplay();
    display.drawBitmap(84 + x, 2, enemySprites[currentEnemy], 42, 42, WHITE);
    display.drawBitmap(2, 12, playerBackSprites[playerChoice], 42, 42, WHITE);
    drawStaticUI();
    display.display();
    delay(30);
  }
}

void playerShake(int intensity, int duration) {
  for (int i = 0; i < duration; i++) {
    int x = random(-intensity, intensity + 1);
    display.clearDisplay();
    display.drawBitmap(84, 2, enemySprites[currentEnemy], 42, 42, WHITE);
    display.drawBitmap(2 + x, 12, playerBackSprites[playerChoice], 42, 42, WHITE);
    drawStaticUI();
    display.display();
    delay(30);
  }
}

void typebox(const __FlashStringHelper* text, int speed) {
  display.fillRect(1, 45, 126, 18, BLACK);
  display.setCursor(6, 56);
  String s = String(text);
  for (int i = 0; i < s.length(); i++) {
    display.print(s[i]); display.display(); 
    if (digitalRead(BTN_A) == LOW) speed = 5;
    delay(speed);
  }
  delay(500);
}

void typebox(String text, int speed) {
  display.fillRect(1, 45, 126, 18, BLACK);
  display.setCursor(6, 56);
  for (int i = 0; i < text.length(); i++) {
    display.print(text[i]); display.display(); 
    if (digitalRead(BTN_A) == LOW) speed = 5;
    delay(speed);
  }
  delay(500);
}

  void healPlayer(int amount) {
  int targetHP = playerHP + amount;
  if (targetHP > 100) targetHP = 100;

  for (int i = playerHP; i <= targetHP; i++) {
    playerHP = i;
    display.fillRect(82, 53, 31, 1, BLACK); // Clears the old bar
    display.fillRect(82, 53, map(playerHP, 0, 100, 0, 30), 1, WHITE);
    tone(BUZZER_PIN, 400 + (playerHP * 4), 20); 
    display.display();
    delay(40);
  }
  noTone(BUZZER_PIN);
}

  void playVictoryMelody() {
  int melody[] = { NOTE_G4, NOTE_B4, NOTE_D5, NOTE_G5 };
  int durations[] = { 100, 100, 100, 300 }; 

  for (int i = 0; i < 4; i++) {
    tone(BUZZER_PIN, melody[i], durations[i]);
    delay(durations[i] * 1.2); // Small gap between notes for clarity
  }
  noTone(BUZZER_PIN);
}
